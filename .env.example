# English Tutor LMS — environment variables
# Copy to .env.local and fill in. On Vercel, set these in Project → Settings → Environment Variables.

# MongoDB Atlas connection string (Driver → Node.js). Include the db name or set MONGODB_DB.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="etlms"

# JWT signing secret for the HttpOnly session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# Admin account created by `npm run seed`.
ADMIN_EMAIL="teacher@tutor.app"
ADMIN_PASSWORD="demo1234"
ADMIN_NAME="Sarah Mitchell"
